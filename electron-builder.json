{
  "appId": "com.myapp.desktopwebclient",
  "productName": "DesktopWebClient",
  "directories": {
    "output": "release"
  },
  "publish": [
    {
      "provider": "github"
    }
  ],
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Desktop Web Client"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility"
  }
}
